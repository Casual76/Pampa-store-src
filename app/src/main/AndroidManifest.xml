<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        Serve per aprire il dialogo di disinstallazione, che e' l'unica strada verso una versione
        precedente: Android riserva al sistema la deroga a INSTALL_FAILED_VERSION_DOWNGRADE, quindi
        rimettere una vecchia release significa togliere l'app e reinstallarla. Senza questa
        permission startActivity(ACTION_DELETE) non solleva niente e non apre niente: fallisce in
        silenzio, che e' il modo peggiore in cui poteva fallire.
    -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!--
        Da Android 13 pubblicare una notifica richiede il consenso. Non si chiede all'avvio: si
        chiede quando la persona apre la scheda Aggiornamenti, cioe' nel momento in cui la richiesta
        ha un contesto invece di essere il primo dialogo di un'app appena installata.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Da Android 11 un'app non vede piu' quali altre app sono installate, se non le dichiara.
        Senza questa, getPackageInfo solleva NameNotFound per qualunque pacchetto del catalogo, lo
        store conclude che non e' installato niente, e nessun aggiornamento compare mai: mostra il
        pulsante di download anche per un'app che hai gia'.

        <queries> con un elenco fisso non basta: il catalogo arriva da remoto e cambia. Un app store
        e' il caso d'uso per cui QUERY_ALL_PACKAGES esiste. La restrizione di Google Play su questa
        permission non tocca il Pampa Store, che su Play non c'e'.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!--
        La coda delle installazioni avviata da PampAI/Aria gira anche senza una schermata dello
        Store aperta: il service in primo piano tiene vivo il processo durante il download.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!--
        engine-ai (che porta i tipi dei tool per il bridge) dichiara il microfono per la voce
        dell'assistente: lo Store non ascolta nessuno, e il permesso non deve comparire.
    -->
    <uses-permission
        android:name="android.permission.RECORD_AUDIO"
        tools:node="remove" />

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Pampa Store"
        android:supportsRtl="true"
        android:theme="@style/Theme.PampaStore"
        android:usesCleartextTraffic="false">

        <!--
            singleTask: toccare la notifica deve riportare allo Store che e' gia' aperto, non
            impilarne una seconda copia sopra quella in cui si stava gia' guardando il catalogo.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".platform.PackageInstallResultReceiver"
            android:exported="false" />

        <!--
            I tool dello Store per PampAI/Aria: protetti dal permesso `signature` del bridge, quindi
            li chiama solo un'app firmata con la stessa chiave. L'authority segue l'applicationId:
            la build di debug ha la sua.
        -->
        <provider
            android:name=".pampai.StoreToolHostProvider"
            android:authorities="${applicationId}.ai.tools"
            android:exported="true"
            android:permission="dev.antigravity.fluidengine.permission.AI_TOOLS">
            <meta-data
                android:name="dev.antigravity.fluidengine.ai.TOOL_HOST"
                android:value="1" />
        </provider>

        <service
            android:name=".pampai.StoreInstallService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>
